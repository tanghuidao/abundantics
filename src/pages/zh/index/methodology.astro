---
import TerminalLayout from '../../../layouts/TerminalLayout.astro';
import { getTranslations, type Locale } from '../../../i18n/utils';
import { loadIndexData } from '../../../lib/data';

const locale: Locale = 'zh';
const t = getTranslations(locale);
const data = loadIndexData();
const mv = data.method_version || '0.1';
const bibtex = `@misc{tang2026tepi,
  title = {TEPI --- Token Energy Parity Index: Index Methodology v0.1},
  author = {Tang, Huidao},
  year = {2026},
  url = {https://abundantics.org/en/index/methodology/},
  note = {Abundantics Empirical Module 01. Method v0.1, accessed YYYY-MM-DD}
}`;
---

<TerminalLayout locale={locale} title={`TEPI ${t.index.methodology} v${mv}`}>
  <div class="px-6 md:px-12 py-8 md:py-12 max-w-4xl mx-auto w-full">
    <div class="mb-8">
      <h1 class="font-mono text-2xl text-term-fg font-medium tracking-tight">
        TEPI — Token 能量平价指数 · 指数方法论
      </h1>
      <p class="font-mono text-sm text-term-muted mt-2">
        版本 {mv}（审阅稿）· 2026 年 8 月 16 日 · 丰裕学研究项目 · 实证模块 01
      </p>
      <p class="font-mono text-xs text-term-muted mt-1">
        数据与方法论：CC-BY 4.0 · 代码开源 · 非投资建议
      </p>
    </div>

    <div class="mb-8 p-4 border border-term-border rounded-lg bg-term-bg/50">
      <p class="font-mono text-xs text-term-muted leading-relaxed">
        状态声明：内部审阅稿。公式与验算示例均已对照参考实现及 2026-08-16 已发布序列核验。标注 [待核验] 之处为尚待独立溯源的工作假设。本文档尚未经过外部评审。
      </p>
      <p class="font-mono text-xs text-term-muted leading-relaxed mt-2">
        本中文版为译本，由英文原本（English original）派生；两版本如有出入，以英文原本为准。
      </p>
    </div>

    <div class="space-y-8 font-mono text-sm text-term-fg leading-relaxed">

      <section>
        <h2 class="text-accent-red text-base font-medium mb-3">1. 目的与范围</h2>
        <p class="text-term-fg/80">
          Token 能量平价指数（TEPI）是一个日频指数族：它把电能的两种 token 生产用途放到同一个物理公分母——每千瓦时毛收入——之上，并追踪二者的比值。其一为工作量证明加密货币挖矿（当前为比特币），在丰裕学研究纲领中被解读为防御性耗散（为保卫既有权利主张而消耗的能量）；其二为大语言模型推理，被解读为生产性耗散（为产出认知性成果而消耗的能量）。这组解读性标签是一种研究透镜，而非规范性裁决；第 9 节交代其学术血统与适用限度。
        </p>
        <p class="text-term-fg/80 mt-3">
          TEPI 回答一个狭窄而可测量的问题：按今天的市场价格，一度电在两种用途中各挣多少毛收入？经测得的模型质量调整之后，缺口有多大？ 它不度量利润率、福祉或能耗份额，也不构成投资建议。
        </p>
      </section>

      <section>
        <h2 class="text-accent-red text-base font-medium mb-3">2. 指数族</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-xs border-collapse">
            <thead>
              <tr class="border-b border-term-border">
                <th class="text-left py-2 pr-4 text-term-muted">量</th>
                <th class="text-left py-2 pr-4 text-term-muted">名称</th>
                <th class="text-left py-2 pr-4 text-term-muted">单位</th>
                <th class="text-left py-2 text-term-muted">定义</th>
              </tr>
            </thead>
            <tbody class="text-term-fg/80">
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4 text-accent-red">R_M</td><td class="py-2 pr-4">挖矿每度电毛收入</td><td class="py-2 pr-4">USD/kWh</td><td class="py-2">全网加权能效下一度电的挖矿毛收入</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4 text-accent-red">R_A</td><td class="py-2 pr-4">推理每度电毛收入</td><td class="py-2 pr-4">USD/kWh</td><td class="py-2">按用量权重加权的模型篮子一度电推理毛收入</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4 text-accent-red">Λ</td><td class="py-2 pr-4">能量套利比率</td><td class="py-2 pr-4">无量纲</td><td class="py-2">R_A / R_M（以链式接续序列发布）</td></tr>
              <tr><td class="py-2 pr-4 text-accent-red">Ω</td><td class="py-2 pr-4">平价偏离指数</td><td class="py-2 pr-4">无量纲（对数）</td><td class="py-2">质量调整后焦耳平价汇率与市场隐含汇率之比的对数</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-term-muted mt-3 text-xs">同时发布的辅助量：ε<sub>BTC</sub>（每枚 BTC 的内含能量，GWh）、进入 Ω 的两个汇率 ρ<sub>parity</sub> 与 ρ<sub>market</sub>、篮子概要统计量，以及第 6 节的链式接续元数据。</p>
      </section>

      <section>
        <h2 class="text-accent-red text-base font-medium mb-3">3. 符号约定</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-xs border-collapse">
            <thead>
              <tr class="border-b border-term-border">
                <th class="text-left py-2 pr-4 text-term-muted">符号</th>
                <th class="text-left py-2 pr-4 text-term-muted">含义</th>
                <th class="text-left py-2 text-term-muted">单位</th>
              </tr>
            </thead>
            <tbody class="text-term-fg/80">
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">P<sub>BTC</sub></td><td class="py-2 pr-4">比特币现货价格</td><td class="py-2">USD</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">H</td><td class="py-2 pr-4">全网算力</td><td class="py-2">PH/s</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">B</td><td class="py-2 pr-4">近 144 个区块的区块奖励合计（补贴 + 手续费）</td><td class="py-2">BTC/日</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">η</td><td class="py-2 pr-4">全网加权挖矿能效（人工参数）</td><td class="py-2">J/TH</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">p<sub>i</sub></td><td class="py-2 pr-4">篮子模型 i 的输出 token 挂牌价</td><td class="py-2">USD/token</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">j<sub>i</sub></td><td class="py-2 pr-4">模型 i 每输出 token 全栈能耗，含 PUE（D′ 口径，三档区间见 6.5 节）</td><td class="py-2">J/token</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">w̃<sub>i</sub></td><td class="py-2 pr-4">模型 i 的归一化用量权重（Σ w̃<sub>i</sub> = 1）</td><td class="py-2">—</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">s<sub>i</sub></td><td class="py-2 pr-4">模型 i 的外部质量分（AA Intelligence Index v4.1.1）</td><td class="py-2">分</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">q<sub>i</sub></td><td class="py-2 pr-4">质量权重，s<sub>i</sub> / s<sub>ref</sub></td><td class="py-2">—</td></tr>
              <tr><td class="py-2 pr-4">k</td><td class="py-2 pr-4">每千瓦时的焦耳数，3.6 × 10⁶</td><td class="py-2">J/kWh</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-accent-red text-base font-medium mb-3">4. 数据来源与采样</h2>
        <p class="text-term-fg/80">
          全部输入均为免费、公开、无需密钥的数据。指数由自动化管线（GitHub Actions，UTC 00:10）每日计算一次并追加至公开 CSV；管线、建站脚本与完整序列全部开源。
        </p>
        <div class="overflow-x-auto mt-4">
          <table class="w-full text-xs border-collapse">
            <thead>
              <tr class="border-b border-term-border">
                <th class="text-left py-2 pr-4 text-term-muted">输入</th>
                <th class="text-left py-2 pr-4 text-term-muted">来源</th>
                <th class="text-left py-2 text-term-muted">频率/政策</th>
              </tr>
            </thead>
            <tbody class="text-term-fg/80">
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">比特币现货价</td><td class="py-2 pr-4">CoinGecko simple-price API</td><td class="py-2">运行时每日快照</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">全网算力</td><td class="py-2 pr-4">mempool.space，3 日窗口</td><td class="py-2">每日快照</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">区块奖励</td><td class="py-2 pr-4">mempool.space，近 144 区块</td><td class="py-2">每日快照</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">模型挂牌价</td><td class="py-2 pr-4">OpenRouter /api/v1/models（主源，市场价）</td><td class="py-2">每日快照</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">模型挂牌价（第二源）</td><td class="py-2 pr-4">LiteLLM 厂商直连牌价（对照列 Λ_alt）</td><td class="py-2">每日快照</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">全网能效 η</td><td class="py-2 pr-4">人工设定；锚定 CBECI 与矿机规格书</td><td class="py-2">季度复查；变更记入日志</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">质量分 s<sub>i</sub></td><td class="py-2 pr-4">Artificial Analysis Intelligence Index v4.1.1</td><td class="py-2">季度复查；变更记入日志</td></tr>
              <tr><td class="py-2 pr-4">每 token 能耗 j<sub>i</sub></td><td class="py-2 pr-4">已溯源（D′ 口径）+ 三档敏感性区间</td><td class="py-2">随篮子变更复查；记入日志</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-term-muted mt-3 text-xs">
          有两个参数属于判断性输入，因此以显式的"复查并记录"政策治理，而非当作数据呈现：η（当前 20.0 J/TH）与各模型的 j<sub>i</sub>。j<sub>i</sub> 已从单一工作假设升级为低/中/高三档区间（主口径维持中档点值，见 6.5 节）；二者对各指数的敏感性在第 7 节量化。
        </p>
      </section>

      <section>
        <h2 class="text-accent-red text-base font-medium mb-3">5. 计算方法</h2>

        <h3 class="text-term-fg/90 font-medium mb-2 mt-4">5.1 挖矿侧</h3>
        <p class="text-term-fg/80">
          Hashprice（每 PH/s 每日的挖矿毛收入）除以一个 PH/s 在全网加权能效下的日耗电量，直接得到每度电毛收入：
        </p>
        <div class="my-3 p-3 bg-term-bg/50 border border-term-border rounded text-center text-term-fg">
          R<sub>M</sub> = hashprice / E<sub>PH</sub>，其中 E<sub>PH</sub> = η × 10³ × 86400 / (3.6 × 10⁶) kWh
        </div>
        <p class="text-term-fg/80">
          每枚币的内含能量为全网能耗除以当日产币量。代入可得恒等式：R<sub>M</sub> = k · P<sub>BTC</sub> / ε<sub>BTC</sub>。挖矿每度电毛收入完全由币价和边际一枚币的内含能量决定；难度调整正是把该量持续拴在电价附近的机制（见 9.1 节）。
        </p>

        <h3 class="text-term-fg/90 font-medium mb-2 mt-4">5.2 推理侧</h3>
        <p class="text-term-fg/80">
          对篮子中的每个模型，每度电毛收入等于其输出 token 单价乘以一度电在该模型能耗强度下可产出的 token 数；指数按归一化用量权重加总：
        </p>
        <div class="my-3 p-3 bg-term-bg/50 border border-term-border rounded text-center text-term-fg">
          R<sub>A</sub> = k · Σ(w̃<sub>i</sub> · p<sub>i</sub> / j<sub>i</sub>)
        </div>
        <p class="text-term-fg/80">
          某模型在价格源当日缺失时予以剔除并对权重重新归一化（missing_model_policy = skip），该事件在运行日志中可见。价格为 OpenRouter 默认端点输出 token 的挂牌价；输入 token 的收入与能耗不计入（局限 L2，见第 7 节）。
        </p>

        <h3 class="text-term-fg/90 font-medium mb-2 mt-4">5.3 质量调整与标准 token</h3>
        <p class="text-term-fg/80">
          不同模型的 token 并非同质。TEPI 用一个独立于价格的外部基准，把原始 token 折算为标准 token 当量：质量权重 q<sub>i</sub> = s<sub>i</sub> / s<sub>ref</sub>，其中 s<sub>i</sub> 为该模型的 Artificial Analysis Intelligence Index 分数，基准模型定义 q = 1。模型 i 的一个原始 token 计为 q<sub>i</sub> 个标准 token；质量调整因此作用于数量侧而非价格侧。模型 i 每焦耳的标准 token 数为 t<sub>i</sub> = q<sub>i</sub> / j<sub>i</sub>，篮子合计 T = Σ w̃<sub>i</sub> t<sub>i</sub>。
        </p>

        <h3 class="text-term-fg/90 font-medium mb-2 mt-4">5.4 跨市场平价与 Ω</h3>
        <p class="text-term-fg/80">
          在两个 token 世界之间比较两个汇率：焦耳平价汇率问"一枚 BTC 的内含能量若改投质量调整后的推理，能产出多少标准 token"；市场隐含汇率问"按市场价格，一枚 BTC 能买到多少标准 token"：
        </p>
        <div class="my-3 p-3 bg-term-bg/50 border border-term-border rounded text-center text-term-fg">
          Ω = ln(ρ<sub>parity</sub> / ρ<sub>market</sub>)
        </div>
        <p class="text-term-fg/80">
          解读：Ω 是一个毛收入机会比的对数。Ω = 5.74（2026 年 8 月 16 日，验证运行）的含义是：一枚比特币所内含的能量，若按当前质量调整后的价格改投推理，可获得约 e<sup>5.74</sup> ≈ 311 倍于该比特币市价的毛收入。第 7 节的毛收入口径限定适用于其水平值；真正有信息量的对象是序列本身。
        </p>
        <p class="text-term-fg/80 mt-3">
          以下分解恒等式贯穿全程用于验证，把 Ω 分离为原始比值与纯质量项：
        </p>
        <div class="my-3 p-3 bg-term-bg/50 border border-term-border rounded text-center text-term-fg">
          Ω = ln Λ + (Ω − ln Λ)，其中 (Ω − ln Λ) 为纯质量项
        </div>

        <h3 class="text-term-fg/90 font-medium mb-2 mt-4">5.5 价格型质量权重为何不可采用（退化结果）</h3>
        <p class="text-term-fg/80">
          <strong>命题：</strong>若质量权重由价格定义，即 q<sub>i</sub> = p<sub>i</sub> / p<sub>ref</sub>，则对任意配置、任意日期，恒有 Ω ≡ ln Λ。
        </p>
        <p class="text-term-fg/80 mt-2">
          <strong>证明：</strong>将 q<sub>i</sub> = p<sub>i</sub>/p<sub>ref</sub> 代入 T，得 T = Σ w̃<sub>i</sub> p<sub>i</sub> / (p<sub>ref</sub> · j<sub>i</sub>)。于是 ρ<sub>parity</sub>/ρ<sub>market</sub> = ε<sub>BTC</sub> · T · p<sub>ref</sub> / P<sub>BTC</sub> = ε<sub>BTC</sub> · Σ w̃<sub>i</sub> p<sub>i</sub>/j<sub>i</sub> / P<sub>BTC</sub>。而 Λ = R<sub>A</sub>/R<sub>M</sub> = (k Σ w̃<sub>i</sub> p<sub>i</sub>/j<sub>i</sub>) / (k P<sub>BTC</sub>/ε<sub>BTC</sub>) = ε<sub>BTC</sub> · Σ w̃<sub>i</sub> p<sub>i</sub>/j<sub>i</sub> / P<sub>BTC</sub>——两式相同，故 Ω = ln Λ。∎
        </p>
        <p class="text-term-fg/80 mt-2">
          本指数第 0 版即采用价格型权重，并确实呈现了该退化（发布快照实测：Ω = 5.457 = ln 234.4）。用价格度量质量、再回头追问价格是否偏离质量调整后的平价，等于以被测对象充当自身的量尺。v0.1 方法论因此要求质量分必须来自独立于价格的来源；若任一篮子模型缺少现行分数，Ω 按缺失发布，而不在退化口径下勉强计算。
        </p>
      </section>

      <section>
        <h2 class="text-accent-red text-base font-medium mb-3">6. 篮子构建与维护</h2>

        <h3 class="text-term-fg/90 font-medium mb-2 mt-4">6.1 入选原则</h3>
        <ul class="space-y-1 text-term-fg/80 list-disc list-inside">
          <li><strong>覆盖性：</strong>各主要厂商系列各取一个高用量（走量而非旗舰）模型，使 R<sub>A</sub> 反映市场实际成交量所在价格水平上的收入。</li>
          <li><strong>可定价性：</strong>模型须在价格源上有默认端点挂牌。</li>
          <li><strong>可评分性：</strong>模型须有现行外部质量分（见 6.4 节）；否则 Ω 暂停发布，而非近似凑数。</li>
          <li><strong>简约性：</strong>篮子刻意保持小规模（当前四个模型）；代表性通过权重实现，权重对照公开用量排行复查。</li>
        </ul>

        <h3 class="text-term-fg/90 font-medium mb-2 mt-4">6.2 现行篮子（版本 v1，2026-08-16 生效）</h3>
        <div class="overflow-x-auto mt-3">
          <table class="w-full text-xs border-collapse">
            <thead>
              <tr class="border-b border-term-border">
                <th class="text-left py-2 pr-4 text-term-muted">模型（OpenRouter id）</th>
                <th class="text-left py-2 pr-4 text-term-muted">权重</th>
                <th class="text-left py-2 pr-4 text-term-muted">j<sub>i</sub> (J/tok)</th>
                <th class="text-left py-2 pr-4 text-term-muted">分数 s<sub>i</sub></th>
                <th class="text-left py-2 text-term-muted">取分变体</th>
              </tr>
            </thead>
            <tbody class="text-term-fg/80">
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">anthropic/claude-sonnet-5（基准）</td><td class="py-2 pr-4">0.30</td><td class="py-2 pr-4">3.0</td><td class="py-2 pr-4">55</td><td class="py-2">Adaptive Reasoning, Max</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">openai/gpt-5.5</td><td class="py-2 pr-4">0.25</td><td class="py-2 pr-4">3.0</td><td class="py-2 pr-4">56</td><td class="py-2">xhigh</td></tr>
              <tr class="border-b border-term-border/50"><td class="py-2 pr-4">google/gemini-3.7-flash</td><td class="py-2 pr-4">0.25</td><td class="py-2 pr-4">1.0</td><td class="py-2 pr-4">56</td><td class="py-2">high</td></tr>
              <tr><td class="py-2 pr-4">deepseek/deepseek-v4-pro</td><td class="py-2 pr-4">0.20</td><td class="py-2 pr-4">1.5</td><td class="py-2 pr-4">53</td><td class="py-2">0813, Reasoning Max</td></tr>
            </tbody>
          </table>
        </div>
        <p class="text-term-muted mt-3 text-xs">
          取分口径：对每个模型，取基准机构在复查日已评分的最高推理档位（"最高已评档"）。分数取自 Artificial Analysis Intelligence Index v4.1.1，查询于 2026-08-16。基准模型的分数（55）位于篮子分数区间（53–56）之内，避免了基准落在极端值上。
        </p>

        <h3 class="text-term-fg/90 font-medium mb-2 mt-4">6.3 Λ 的链式接续</h3>
        <p class="text-term-fg/80">
          Λ 的水平值对篮子构成高度敏感，而模型更替预期将会频繁。参照消费者价格指数的链式接续做法（ILO 等，2020），发布序列 Λ<sub>chained</sub> 度量的是变动，而非篮子水平。每套篮子配置带有版本标签（v1、v2、……）。登记文件 chain_factors.json 把每个版本映射到累计接续系数；v1 ≡ 1.0。
        </p>
        <p class="text-term-fg/80 mt-2">
          换篮当日，新旧两套配置就同一天并行计算（试运行）。新版本的系数按接续点连续的要求设定：factor<sub>new</sub> = Λ<sub>chained</sub>(旧) / Λ<sub>raw</sub>(新)。Λ（原始值，当期篮子）与 Λ<sub>chained</sub>（接续值）同时发布；图表与分析使用 Λ<sub>chained</sub>。每次接续在 changelog 中记录日期、进出模型与系数。
        </p>
        <p class="text-term-fg/80 mt-2">
          v0.1 中 Ω 不做链式接续：其质量比值结构已消除对篮子水平的一阶敏感性；接续事件的实际影响将在首次发生时实证评估（开放问题 O5）。
        </p>

        <h3 class="text-term-fg/90 font-medium mb-2 mt-4">6.4 质量分治理</h3>
        <p class="text-term-fg/80">
          分数每季度复查一次，篮子变更时同步复查；每次采纳的变更在 changelog 记一行（日期、旧分 → 新分、基准版本）。已发布历史永不回溯修改。基准本身由其发布机构版本化（采纳时为 v4.1.1）并会随时间调整权重；现行基准版本属于记录的一部分。基准改版在文档处理上视同一次篮子接续。
        </p>

        <h3 class="text-term-fg/90 font-medium mb-2 mt-4">6.5 j<sub>i</sub> 溯源与 Λ 置信带</h3>
        <p class="text-term-fg/80">
          每输出 token 的全栈能耗 j<sub>i</sub> 曾是本指数最薄弱的输入（局限 L5）。2026-09-01 完成溯源定稿：j<sub>i</sub> 口径订正为 D′ —— 全栈能耗除以计费输出 token（含思考 token），依据四家厂商官方文档与 OpenRouter API 实测核验，确认 reasoning token 按输出 token 计价计费。逐项出处见仓库溯源附录（docs/ji_source.md）。
        </p>
        <p class="text-term-fg/80 mt-2">
          为缓解单一工作假设的不确定性，自 2026-09-01 起每个篮子模型配置低/中/高三档 j<sub>i</sub>（主口径维持中档点值，加权 j̄ = 2.2 J/token）。主序列由此新增 Λ 置信带四列：R_A_low / R_A_high / Lambda_low / Lambda_high —— 定义为逐模型把 j<sub>i</sub> 替换为低/高档后重新聚合（价格与权重不变），而非对加权均值整体缩放。主列（R_A / Lambda / Omega 等）口径与数值零影响，历史行留空不回填。
        </p>

        <h3 class="text-term-fg/90 font-medium mb-2 mt-4">6.6 篮子代表性口径声明与国外对标</h3>
        <p class="text-term-fg/80">
          当前篮子（v1）为前沿 reasoning 模型篮子（加权均价约 $11.44/百万 token）。Λ 度量的是前沿推理口径的能量套利比，不代表全 AI 行业平均水平；产业界常引用的"20–25 倍"对应走量（commodity）模型口径（均价约 $1/百万 token），两口径各自自洽。
        </p>
        <p class="text-term-fg/80 mt-2">
          最接近的同赛道对标是 Compute Heat Rate（CHR，Hans Royal 提出、2026 年被 PJM 电网白皮书引用）：其混合口径 R_w ≈ $12.5/kWh 与 TEPI 的 R_A ≈ $15.4/kWh 同量级，构成独立方法的交叉验证；CHR 隐含的单 token 能耗 1.1–2.8 J/token 亦与 TEPI 篮子 j<sub>i</sub>（1.0–3.0）独立收敛。逐维度对比见仓库研究文档《CHR vs TEPI 逐条对比》。
        </p>
      </section>

      <section>
        <h2 class="text-accent-red text-base font-medium mb-3">7. 核算边界与已知局限</h2>
        <p class="text-term-fg/80 mb-3">TEPI 是一个在显式声明边界下的"每单位能量毛收入"指数。各项边界选择、理由与偏差方向如下：</p>
        <ul class="space-y-3 text-term-fg/80">
          <li><strong class="text-accent-red">L1 — 毛收入而非利润。</strong>电力是挖矿的主导边际成本，却只占推理成本的次要份额。因此 Λ 的水平值不能读作利润套利；有经济含义的对象是趋势、比值对事件的响应，以及两侧变动的相互比较。净利率变体 Λ′ 已阶段一试算（2026 Q2：现金口径 Λ′≈420、全成本口径双侧皆负），见 11 节 O2 与仓库试算稿 docs/lambda_prime.md。</li>
          <li><strong class="text-accent-red">L2 — 仅计输出 token。</strong>推理收入与能耗按输出 token 及输出价计算；输入 token 收入与 prefill 能耗未计入。若输入定价高于 prefill 能耗成本，则本口径低估推理侧每度电收入。修正需要日频的输入/输出配比数据，目前无公开来源 [待核验]。</li>
          <li><strong class="text-accent-red">L3 — 满负荷惯例。</strong>R<sub>A</sub> 把每一度电都按挂牌价的 token 产出计价，即假设 100% 可计费利用率。实际集群利用率低于此，故 R<sub>A</sub> 是已实现每度电收入的上界；R<sub>M</sub> 无可比楔子。Λ 相应地也是上界。</li>
          <li><strong class="text-accent-red">L4 — 全网平均、人工设定的 η。</strong>R<sub>M</sub> 与 ε<sub>BTC</sub> 随 η 线性（反向）缩放。η = 20 J/TH 锚定于公开的全网估计与现役矿机规格，季度复查。敏感性：η 变动 ±25% 使 R<sub>M</sub> 反向变动 25%，使 Λ 的对数水平变动 ±ln(1.25) ≈ ±0.22。</li>
          <li><strong class="text-accent-red">L5 — j<sub>i</sub> 的不确定性（已缓解）。</strong>每输出 token 的全栈能耗（含 PUE）曾是最薄弱的输入：公开测量稀缺、各模型真实值属厂商机密，配置值（每输出 token 1.0–3.0 焦耳）为数量级工作假设。2026-09-01 已通过溯源定稿（D′ 口径）与低/中/高三档置信带缓解——以区间而非单点值承载该不确定度（见 6.5 节）。</li>
          <li><strong class="text-accent-red">L6 — 单链、单一价格源（已缓解）。</strong>挖矿侧仅比特币；推理侧主源经由单一聚合商（OpenRouter）的默认端点定价。自 2026-09-01 起引入 LiteLLM 厂商牌价第二源平行计算对照列 Λ_alt 与偏离度 alt_deviation（超 ±15% 触发哨兵），主列仍只用 OpenRouter 市场价、不自动切换源。两项选择均以可复现性优先于完备性，如实声明而不加掩饰。</li>
        </ul>
      </section>

