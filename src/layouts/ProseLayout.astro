---
import { getTranslations, getOppositeLocale, getOppositeLocalePath, type Locale } from '../i18n/utils';
import Nav from '../components/Nav.astro';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/700.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  wide?: boolean;
  hasAlternate?: boolean;
  langSwitchHref?: string;
}

const { locale, title, description, wide = false, hasAlternate = true, langSwitchHref } = Astro.props;
const t = getTranslations(locale);
const otherLocale = getOppositeLocale(locale);
const otherLocalePath = getOppositeLocalePath(Astro.url.pathname, locale);
const pageTitle = title ? `${title} · ${t.site.nameEn}` : `${t.site.name} · ${t.site.nameEn}`;
const siteOrigin = (Astro.site?.toString() ?? 'https://abundantics.org').replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const thisLocaleUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const altLocaleUrl = new URL(otherLocalePath, siteOrigin).toString();
---

<!DOCTYPE html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={locale} href={thisLocaleUrl} />
  {hasAlternate && <link rel="alternate" hreflang={otherLocale} href={altLocaleUrl} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-prose-bg text-prose-fg min-h-screen flex flex-col">
  <Nav locale={locale} theme="prose" langSwitchHref={langSwitchHref ?? otherLocalePath} />
  <main class="flex-1">
    <div class={`mx-auto px-6 md:px-12 py-12 md:py-16 ${wide ? 'max-w-5xl' : 'max-w-prose'}`}>
      <slot />
    </div>
  </main>
  <footer class="px-6 py-4 md:px-12 border-t border-prose-border">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-2 text-xs text-prose-muted">
      <span>{t.site.nameEn} · CC-BY 4.0</span>
      <span>{t.site.tagline}</span>
    </div>
  </footer>
</body>
</html>
